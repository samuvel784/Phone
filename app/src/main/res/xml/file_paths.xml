<paths>
    <!-- Current app-private recordings (encrypted, or legacy plaintext) -->
    <files-path name="call_recordings" path="CallRecordings/" />

    <!-- Legacy recordings kept in app-specific external storage -->
    <external-files-path name="external_recordings" path="CallRecordings/" />
    <external-files-path name="external_music_recordings" path="Music/CallRecordings/" />

    <!-- Temporary decrypted recording used for playback/sharing -->
    <cache-path name="cache_recordings" path="CallRecordings/" />

    <!-- Contact vCard written for an explicit share -->
    <cache-path name="cache_exports" path="exports/" />
</paths>
