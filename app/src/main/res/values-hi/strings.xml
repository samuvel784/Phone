    <!-- Backup restore safety -->
    <string name="backup_plaintext_warning_title">बिना एन्क्रिप्शन वाली बैकअप फ़ाइल</string>
    <string name="backup_plaintext_warning_body">यह एक पुराना बैकअप है जो एन्क्रिप्टेड नहीं है। इसमें संपर्क, फ़ोन नंबर, कॉल इतिहास, नोट्स, रिमाइंडर और सेटिंग्स पढ़ने योग्य रूप में हो सकते हैं। बहाल करने पर यह आपके मौजूदा डेटा के साथ मिल जाता है और आपका पहले से मौजूद सब कुछ बना रहता है। केवल तभी जारी रखें जब आप इस फ़ाइल पर भरोसा करते हैं।</string>
    <string name="backup_plaintext_warning_confirm">फिर भी बहाल करें</string>
    <string name="backup_error_empty_file">चुनी गई फ़ाइल खाली है।</string>
    <string name="backup_error_too_large">चुनी गई फ़ाइल Nova Dialer बैकअप के लिए बहुत बड़ी है।</string>
    <string name="backup_error_not_a_backup">यह फ़ाइल Nova Dialer बैकअप नहीं है।</string>
    <string name="backup_error_password_required">बैकअप पासवर्ड दर्ज करें।</string>
    <string name="backup_error_wrong_password">पासवर्ड गलत है या फ़ाइल खराब है।</string>
    <string name="backup_error_unsupported_version">यह बैकअप Nova Dialer के नए संस्करण से बनाया गया है और यहाँ बहाल नहीं किया जा सकता।</string>
    <string name="backup_error_invalid_payload">बैकअप खराब है या उसमें अमान्य डेटा है।</string>

    <!-- Call recording disclosure -->
    <string name="recording_disclosure_title">कॉल रिकॉर्ड करने से पहले</string>
    <string name="recording_disclosure_body">कॉल रिकॉर्ड करने पर ऑडियो इस डिवाइस पर सहेजा जाता है। नई रिकॉर्डिंग को स्टोरेज में एन्क्रिप्ट किया जाना चाहिए, लेकिन एन्क्रिप्शन विफल हो सकता है और तब Nova Dialer अपने निजी ऐप स्टोरेज में बिना एन्क्रिप्शन वाली प्रति रख सकता है। डिवाइस, Android संस्करण, नेटवर्क और निर्माता की सीमाएँ रिकॉर्डिंग रोक सकती हैं या यह सीमित कर सकती हैं कि कॉल का कौन-सा पक्ष रिकॉर्ड होता है। स्थानीय कानूनों का पालन करना और प्रतिभागियों से आवश्यक सहमति लेना आपकी ज़िम्मेदारी है।</string>
    <string name="recording_disclosure_accept">मैं समझ गया</string>
    <string name="recording_auto_disclosure_title">स्वचालित रिकॉर्डिंग चालू करें?</string>
    <string name="recording_auto_disclosure_body">यह चालू रहने पर, आपकी रिकॉर्डिंग शर्तों से मेल खाने वाली कॉल स्वचालित रूप से रिकॉर्ड हो सकती हैं, हर बार आपसे पूछे बिना। ऊपर दिया गया रिकॉर्डिंग नोटिस लागू रहता है। आप इसे कभी भी बंद कर सकते हैं।</string>
    <string name="recording_auto_disclosure_confirm">स्वचालित रिकॉर्डिंग चालू करें</string>
    <string name="recording_export_warning_title">चलाने योग्य प्रति निर्यात करें?</string>
    <string name="recording_export_warning_body">Downloads में लिखी गई फ़ाइल डिक्रिप्टेड होती है और अन्य ऐप्स इसे खोल सकते हैं। Nova Dialer हटाने पर भी यह डिवाइस पर रहती है और अब ऐप के एन्क्रिप्शन द्वारा सुरक्षित नहीं रहती।</string>
    <string name="recording_export_warning_confirm">बिना एन्क्रिप्शन वाली प्रति निर्यात करें</string>
    <string name="recording_share_warning_title">चलाने योग्य प्रति साझा करें?</string>
    <string name="recording_share_warning_body">आपके द्वारा साझा की गई प्रति डिक्रिप्टेड है और आपके चुने हुए ऐप द्वारा खोली जा सकती है। Nova Dialer इसे उस ऐप, प्राप्तकर्ता के डिवाइस या उसके द्वारा बनाए गए किसी बैकअप से हटा नहीं सकता, और यह अब ऐप की एन्क्रिप्शन द्वारा सुरक्षित नहीं है।</string>
    <string name="recording_share_warning_confirm">डिक्रिप्टेड प्रति साझा करें</string>
    <string name="recording_export_all">सभी रिकॉर्डिंग निर्यात करें</string>
</resources>
