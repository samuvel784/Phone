    <!-- Backup restore safety -->
    <string name="backup_plaintext_warning_title">ملف نسخة احتياطية غير مشفّر</string>
    <string name="backup_plaintext_warning_body">هذه نسخة احتياطية قديمة وغير مشفّرة. قد تحتوي على جهات اتصال وأرقام هواتف وسجل مكالمات وملاحظات وتذكيرات وإعدادات بشكل مقروء. الاستعادة تدمجها مع بياناتك الحالية وتحتفظ بكل ما لديك. تابع فقط إذا كنت تثق بهذا الملف.</string>
    <string name="backup_plaintext_warning_confirm">استعادة على أي حال</string>
    <string name="backup_error_empty_file">الملف المحدد فارغ.</string>
    <string name="backup_error_too_large">الملف المحدد كبير جدًا بحيث لا يمكن أن يكون نسخة احتياطية من Nova Dialer.</string>
    <string name="backup_error_not_a_backup">هذا الملف ليس نسخة احتياطية من Nova Dialer.</string>
    <string name="backup_error_password_required">أدخل كلمة مرور النسخة الاحتياطية.</string>
    <string name="backup_error_wrong_password">كلمة المرور غير صحيحة، أو الملف تالف.</string>
    <string name="backup_error_unsupported_version">أُنشئت هذه النسخة الاحتياطية بإصدار أحدث من Nova Dialer ولا يمكن استعادتها هنا.</string>
    <string name="backup_error_invalid_payload">النسخة الاحتياطية تالفة أو تحتوي على بيانات غير صالحة.</string>

    <!-- Call recording disclosure -->
    <string name="recording_disclosure_title">قبل تسجيل مكالمة</string>
    <string name="recording_disclosure_body">تسجيل مكالمة يحفظ الصوت على هذا الجهاز. من المفترض أن تكون التسجيلات الجديدة مشفّرة أثناء التخزين، لكن قد يفشل التشفير، وفي هذه الحالة قد يحتفظ Nova Dialer بنسخة غير مشفّرة داخل تخزين التطبيق الخاص. قد تمنع قيود الجهاز وإصدار Android وشبكة الاتصال والشركة المصنّعة التسجيل أو تحدّ من الجهة التي يتم تسجيلها. أنت مسؤول عن الالتزام بالقوانين المحلية وعن الحصول على أي موافقة مطلوبة من المشاركين.</string>
    <string name="recording_disclosure_accept">أفهم ذلك</string>
    <string name="recording_auto_disclosure_title">تفعيل التسجيل التلقائي؟</string>
    <string name="recording_auto_disclosure_body">عند تفعيل هذا، قد تُسجَّل المكالمات المطابقة لشروط التسجيل تلقائيًا دون سؤالك في كل مرة. يظل إشعار التسجيل أعلاه ساريًا. يمكنك إيقاف هذا في أي وقت.</string>
    <string name="recording_auto_disclosure_confirm">تفعيل التسجيل التلقائي</string>
    <string name="recording_export_warning_title">تصدير نسخة قابلة للتشغيل؟</string>
    <string name="recording_export_warning_body">الملف المكتوب في التنزيلات يكون غير مشفّر ويمكن للتطبيقات الأخرى فتحه. ويبقى على الجهاز حتى إذا أزلت Nova Dialer، ولم يعد محميًا بتشفير التطبيق.</string>
    <string name="recording_export_warning_confirm">تصدير نسخة غير مشفّرة</string>
    <string name="recording_share_warning_title">مشاركة نسخة قابلة للتشغيل؟</string>
    <string name="recording_share_warning_body">النسخة التي تشاركها غير مشفرة ويمكن للتطبيق الذي تختاره فتحها. لا يستطيع Nova Dialer حذفها من ذلك التطبيق أو من جهاز المستلم أو من أي نسخة احتياطية ينشئها، ولم تعد محمية بتشفير التطبيق.</string>
    <string name="recording_share_warning_confirm">مشاركة نسخة غير مشفرة</string>
