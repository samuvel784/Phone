    <!-- Call recording disclosure -->
    <string name="recording_disclosure_title">Antes de grabar una llamada</string>
    <string name="recording_disclosure_body">Grabar una llamada guarda el audio en este dispositivo. Las grabaciones nuevas están pensadas para cifrarse en reposo, pero el cifrado puede fallar y, en ese caso, Nova Dialer puede conservar una copia sin cifrar dentro de su almacenamiento privado. Las limitaciones del dispositivo, la versión de Android, el operador y el fabricante pueden impedir la grabación o limitar qué lado de la llamada se captura. Eres responsable de cumplir las leyes locales y de obtener el consentimiento que deban dar los participantes.</string>
    <string name="recording_disclosure_accept">Entendido</string>
    <string name="recording_auto_disclosure_title">¿Activar la grabación automática?</string>
    <string name="recording_auto_disclosure_body">Mientras esté activada, las llamadas que cumplan tus condiciones de grabación podrán grabarse automáticamente sin preguntarte cada vez. El aviso de grabación anterior sigue aplicándose. Puedes desactivarla en cualquier momento.</string>
    <string name="recording_auto_disclosure_confirm">Activar grabación automática</string>
    <string name="recording_export_warning_title">¿Exportar una copia reproducible?</string>
    <string name="recording_export_warning_body">El archivo que se guarda en Descargas no está cifrado y otras aplicaciones pueden abrirlo. Permanece en el dispositivo aunque desinstales Nova Dialer y ya no está protegido por el cifrado de la aplicación.</string>
    <string name="recording_export_warning_confirm">Exportar copia sin cifrar</string>
    <string name="recording_share_warning_title">¿Compartir una copia reproducible?</string>
    <string name="recording_share_warning_body">La copia que compartes no está cifrada y puede abrirla la aplicación que elijas. Nova Dialer no puede eliminarla de esa aplicación, del dispositivo del destinatario ni de las copias de seguridad que este haga, y ya no está protegida por el cifrado de la aplicación.</string>
    <string name="recording_share_warning_confirm">Compartir copia sin cifrar</string>
    <string name="recording_export_all">Exportar todas las grabaciones</string>
    <string name="default_dialer_card_title">Establecer como aplicación de teléfono predeterminada</string>
    <string name="default_dialer_card_reason">Necesario para la gestión completa de llamadas y la pantalla de llamada.</string>
