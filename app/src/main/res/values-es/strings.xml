    <!-- Permissions -->
    <string name="enable_contacts_perm">Habilitar contactos</string>
    <string name="enable_call_log_perm">Habilitar registro de llamadas</string>
    <string name="contacts_perm_desc">Para acceder, cargar, editar y llamar a los contactos de su teléfono, habilite el permiso de Contactos.</string>
    <string name="call_log_perm_desc">Para acceder, cargar y llamar al historial de llamadas real de su teléfono, habilite el permiso del Registro de llamadas.</string>

    <string name="permission_disclosure_title">Permisos y privacidad de los datos locales</string>
    <string name="permission_disclosure_body">Nova Dialer necesita acceso a los contactos, incluida su edición, para identificar llamadas, mostrar nombres en Recientes y permitirle crear o actualizar un contacto. Para mostrar y gestionar el historial de llamadas, Android exige que Nova Dialer sea tu aplicación de Teléfono predeterminada y que concedas acceso al historial de llamadas, incluido el borrado de entradas cuando lo solicites. En un dispositivo con más de una SIM, el acceso al estado del teléfono permite a Nova Dialer identificar cada SIM y dirigir una llamada a la SIM que elijas. Las notificaciones muestran la pantalla de llamada entrante y los avisos de llamadas perdidas. Toda la información se procesa en este dispositivo y nunca se sube ni se comparte.</string>
    <string name="call_log_disclosure_title">Acceso al historial de llamadas</string>
    <string name="call_log_disclosure_body">Nova Dialer ya es tu aplicación de Teléfono predeterminada. Android exige acceso al historial de llamadas para que Nova Dialer pueda mostrar tus llamadas recientes y permitirte borrar entradas o vaciar el historial cuando lo solicites. Los datos del historial de llamadas permanecen en este dispositivo y nunca se suben ni se comparten.</string>
    <string name="permission_disclosure_continue">Continuar</string>
