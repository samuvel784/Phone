    <string name="backup_error_invalid_payload">La sauvegarde est endommagée ou contient des données non valides.</string>

    <!-- Call recording disclosure -->
    <string name="recording_disclosure_title">Avant d\'enregistrer un appel</string>
    <string name="recording_disclosure_body">Enregistrer un appel conserve l\'audio sur cet appareil. Les nouveaux enregistrements sont censés être chiffrés au repos, mais le chiffrement peut échouer ; dans ce cas, Nova Dialer peut conserver une copie non chiffrée dans son stockage privé. Les limites de l\'appareil, de la version d\'Android, de l\'opérateur et du fabricant peuvent empêcher l\'enregistrement ou limiter le côté de l\'appel capté. Vous êtes responsable du respect des lois locales et de l\'obtention du consentement que vos interlocuteurs doivent donner.</string>
    <string name="recording_disclosure_accept">J\'ai compris</string>
    <string name="recording_auto_disclosure_title">Activer l\'enregistrement automatique ?</string>
    <string name="recording_auto_disclosure_body">Lorsque cette option est active, les appels qui correspondent à vos conditions d\'enregistrement peuvent être enregistrés automatiquement, sans vous demander à chaque fois. L\'avis d\'enregistrement ci-dessus reste valable. Vous pouvez la désactiver à tout moment.</string>
    <string name="recording_auto_disclosure_confirm">Activer l\'enregistrement automatique</string>
    <string name="recording_export_warning_title">Exporter une copie lisible ?</string>
    <string name="recording_export_warning_body">Le fichier écrit dans Téléchargements est déchiffré et peut être ouvert par d\'autres applications. Il reste sur l\'appareil même si vous désinstallez Nova Dialer et n\'est plus protégé par le chiffrement de l\'application.</string>
    <string name="recording_export_warning_confirm">Exporter la copie non chiffrée</string>
    <string name="recording_share_warning_title">Partager une copie lisible ?</string>
    <string name="recording_share_warning_body">La copie que vous partagez est déchiffrée et peut être ouverte par l\'application que vous choisissez. Nova Dialer ne peut pas la supprimer de cette application, de l\'appareil du destinataire ni des sauvegardes que celui-ci effectue, et elle n\'est plus protégée par le chiffrement de l\'application.</string>
    <string name="recording_share_warning_confirm">Partager la copie non chiffrée</string>
    <string name="recording_export_all">Exporter tous les enregistrements</string>
    <string name="default_dialer_card_title">Définir comme application téléphone par défaut</string>
    <string name="default_dialer_card_reason">Nécessaire pour la gestion complète des appels et l’écran d’appel.</string></resources>
