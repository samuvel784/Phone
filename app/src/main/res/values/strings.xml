    <!-- Call recording disclosure -->
    <string name="recording_disclosure_title">Before you record a call</string>
    <string name="recording_disclosure_body">Recording a call saves audio on this device. New recordings are meant to be encrypted at rest, but encryption can fail and Nova Dialer may then keep an unencrypted copy inside its private app storage. Device, Android version, carrier and manufacturer limits can prevent recording or limit which side of the call is captured. You are responsible for following local laws and for obtaining any consent your participants must give.</string>
    <string name="recording_disclosure_accept">I understand</string>
    <string name="recording_auto_disclosure_title">Turn on automatic recording?</string>
    <string name="recording_auto_disclosure_body">While this is on, calls that match your recording conditions may be recorded automatically, without asking you each time. The recording notice above still applies. You can turn this off at any time.</string>
    <string name="recording_auto_disclosure_confirm">Turn on automatic recording</string>
    <string name="recording_export_warning_title">Export a playable copy?</string>
    <string name="recording_export_warning_body">The file written to Downloads is decrypted and can be opened by other apps. It stays on the device even if you uninstall Nova Dialer, and it is no longer protected by the app\'s encryption.</string>
    <string name="recording_export_warning_confirm">Export unencrypted copy</string>
    <string name="recording_share_warning_title">Share a playable copy?</string>
    <string name="recording_share_warning_body">The copy you share is decrypted and can be opened by the app you choose. Nova Dialer cannot delete it from that app, from the recipient\'s device, or from any backup they make, and it is no longer protected by the app\'s encryption.</string>
    <string name="recording_share_warning_confirm">Share unencrypted copy</string>
