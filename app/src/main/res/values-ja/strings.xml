    <!-- Call recording disclosure -->
    <string name="recording_disclosure_title">通話を録音する前に</string>
    <string name="recording_disclosure_body">通話を録音すると音声がこの端末に保存されます。新しい録音は保存時に暗号化される想定ですが、暗号化に失敗することがあり、その場合 Nova Dialer はアプリ専用ストレージ内に暗号化されていないコピーを残すことがあります。端末、Android のバージョン、通信事業者、メーカーの制限により、録音できない、または通話のどちら側が録音されるかが制限される場合があります。現地の法律を守り、参加者に必要な同意を得るのはあなたの責任です。</string>
    <string name="recording_disclosure_accept">理解しました</string>
    <string name="recording_auto_disclosure_title">自動録音を有効にしますか？</string>
    <string name="recording_auto_disclosure_body">これが有効な間、録音条件に一致する通話は毎回確認することなく自動的に録音される場合があります。上記の録音に関する注意は引き続き適用されます。いつでもオフにできます。</string>
    <string name="recording_auto_disclosure_confirm">自動録音を有効にする</string>
    <string name="recording_export_warning_title">再生可能なコピーを書き出しますか？</string>
    <string name="recording_export_warning_body">Downloads に書き出されるファイルは復号されており、他のアプリで開くことができます。Nova Dialer をアンインストールしても端末に残り、アプリの暗号化による保護もなくなります。</string>
    <string name="recording_export_warning_confirm">暗号化されていないコピーを書き出す</string>
    <string name="recording_share_warning_title">再生可能なコピーを共有しますか？</string>
    <string name="recording_share_warning_body">共有するコピーは復号化されており、選択したアプリで開くことができます。Nova Dialer は、そのアプリ、受信者の端末、またはそこで作成されたバックアップからこのコピーを削除することはできません。また、アプリの暗号化による保護も失われます。</string>
    <string name="recording_share_warning_confirm">暗号化されていないコピーを共有</string>
    <string name="recording_export_all">すべての録音をエクスポート</string>
</resources>
